<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CsvGenerator\**\*.cs" />
    <Content Remove="CsvGenerator\**" />
    <EmbeddedResource Remove="CsvGenerator\**" />
    <None Remove="CsvGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="installed-plugins\**" />
    <Content Remove="wwwroot\js\plugin-modules\**" />
    <Content Remove="artifacts\**" />
    <None Remove="installed-plugins\**" />
    <None Remove="wwwroot\js\plugin-modules\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\hubspot-sandbox-plugin-abstractions\HubSpotSandbox.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" CopyToPublishDirectory="Always" />
    <None Update="Start-HubSpotCrmSandbox.bat" CopyToPublishDirectory="Always" />
    <None Update="Stop-HubSpotCrmSandbox.bat" CopyToPublishDirectory="Always" />
    <None Update="App_Data\.keep" CopyToPublishDirectory="Always" />
    <None Update="logs\.keep" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
